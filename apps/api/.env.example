# Development example only. Configure production values as Dokploy secrets/environment variables.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://homedash:change-me@localhost:5432/homedash
SESSION_TTL_DAYS=30
# Used once, only when the users table is empty. Never use this placeholder in production.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=change-me

# Optional in development; set both in production if notifications are enabled.
NOTIFICATION_CENTER_URL=
NOTIFICATION_CENTER_READ_TOKEN=
NOTIFICATION_CENTER_TIMEOUT_MS=5000
LOG_LEVEL=info
